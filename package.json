  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "check:db": "node --env-file=.env.local scripts/check-supabase.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "seed:dev": "node --env-file=.env.seed.local scripts/seed-dev.mjs",
    "dev": "next dev",
