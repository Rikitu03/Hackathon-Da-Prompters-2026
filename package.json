    "@radix-ui/react-select": "^2.2.6",
    "@supabase/ssr": "0.6.1",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
