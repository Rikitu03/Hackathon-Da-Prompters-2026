# Public: safe to expose in browser; never a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=https://jchbbechdldfcyralrln.supabase.co
# Accepts a Supabase publishable key (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_O_zeY2nx9naLMyRMMnQcxg_QjzKooxC

# Server-only shared signing key for account-free browser references.
# Provisioned privately in .env.local and private.applicant_session_secret; never NEXT_PUBLIC_.
APPLICANT_SESSION_SECRET=

# Keep actual secrets blank in this tracked template. Share privately with the team.
# Server-side only: never use NEXT_PUBLIC_ on these fields.
LUMEN_API_KEY=
LUMEN_API_SECRET=
# Copy verified endpoints from organizer's Lumen sandbox docs.
LUMEN_OCR_URL=
LUMEN_CHAT_URL=
LUMEN_CHAT_INSTANCE_ID=
# Set to false to switch OCR off without a deploy.
LUMEN_OCR_ENABLED=
# Set to false to switch the chat assistant off without a deploy.
LUMEN_CHAT_ENABLED=
# Explicit opt-in after applying the shared chat-limit migration and reviewing PRODUCT_HELP.md.
LUMEN_PRODUCT_HELP_ENABLED=false
